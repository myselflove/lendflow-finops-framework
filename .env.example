# ============================================================
# LendFlow FinOps Framework — Environment Variables Example
# Copy to .env and fill in real values. NEVER commit .env!
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_64_CHARS

# ── AWS Configuration (Zero-cost local simulation — no real creds needed) ──
# These are NEVER used for actual AWS API calls in the demo framework.
# Infracost / OPA policy checks use static plan files instead.
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=123456789012
# AWS_ACCESS_KEY_ID=AKIA...         # DO NOT set for local demo
# AWS_SECRET_ACCESS_KEY=...         # DO NOT set for local demo

# ── Database (local dev only) ─────────────────────────────────
DATABASE_URL=postgresql://lendflow:lendflow_dev@localhost:5432/lendflow_finops
REDIS_URL=redis://localhost:6379/0

# ── Frontend ──────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_TITLE=LendFlow FinOps Dashboard
VITE_DEMO_MODE=true

# ── FinOps Baseline Figures ──────────────────────────────────
BASELINE_MONTHLY_SPEND=180000
TARGET_MONTHLY_SPEND=120000
SAVINGS_TARGET=60000
LOAN_VOLUME_MONTHLY=500000
NUM_MICROSERVICES=12

# ── Compliance Thresholds ────────────────────────────────────
PCI_DSS_MIN_INSTANCES=3
RBI_LOAN_API_MIN_AZ=2
RBI_CREDIT_SCORING_MIN_AZ=3
SOC2_AUDIT_RETENTION_MONTHS=12

# ── Report Generation ────────────────────────────────────────
REPORT_OUTPUT_DIR=presentation/exports
AUTHOR_NAME=FinOps Platform Engineering Group
CLIENT_NAME=LendFlow Technologies
PROJECT_NAME=Infrastructure Cost Optimisation and FinOps Framework

# ── Alerting / Webhooks ───────────────────────────────────────
ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/your-mock-webhook

