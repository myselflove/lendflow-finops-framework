{
  "ConfigRules": [
    {
      "ConfigRuleName": "lendflow-required-tags-check",
      "Description": "Evaluates whether AWS resources have the 5 required FinOps tags: CostCenter, Environment, Service, Owner, and ComplianceScope.",
      "Scope": {
        "ComplianceResourceTypes": [
          "AWS::EC2::Instance",
          "AWS::EC2::Volume",
          "AWS::RDS::DBInstance",
          "AWS::RDS::DBCluster",
          "AWS::S3::Bucket",
          "AWS::EKS::Cluster"
        ]
      },
      "Source": {
        "Owner": "AWS",
        "SourceIdentifier": "REQUIRED_TAGS"
      },
      "InputParameters": "{\"tag1Key\":\"CostCenter\",\"tag2Key\":\"Environment\",\"tag3Key\":\"Service\",\"tag4Key\":\"Owner\",\"tag5Key\":\"ComplianceScope\"}",
      "MaximumExecutionFrequency": "TwentyFour_Hours"
    },
    {
      "ConfigRuleName": "lendflow-ec2-stopped-instance-check",
      "Description": "Checks whether EC2 instances have been stopped for more than 7 days without termination, preventing idle EBS charges.",
      "Scope": {
        "ComplianceResourceTypes": [
          "AWS::EC2::Instance"
        ]
      },
      "Source": {
        "Owner": "AWS",
        "SourceIdentifier": "EC2_STOPPED_INSTANCE_CHECK"
      },
      "InputParameters": "{\"thresholdDays\":\"7\"}",
      "MaximumExecutionFrequency": "TwentyFour_Hours"
    },
    {
      "ConfigRuleName": "lendflow-ebs-gp3-volume-check",
      "Description": "Verifies that attached EBS volumes use gp3 rather than obsolete gp2 volumes for 20% cost savings and decoupled IOPS.",
      "Scope": {
        "ComplianceResourceTypes": [
          "AWS::EC2::Volume"
        ]
      },
      "Source": {
        "Owner": "AWS",
        "SourceIdentifier": "EC2_VOLUME_INUSE_CHECK"
      },
      "InputParameters": "{\"expectedVolumeType\":\"gp3\"}",
      "MaximumExecutionFrequency": "TwentyFour_Hours"
    },
    {
      "ConfigRuleName": "lendflow-s3-lifecycle-policy-check",
      "Description": "Verifies that S3 buckets have active lifecycle rules transitioning old data to Standard-IA or Glacier.",
      "Scope": {
        "ComplianceResourceTypes": [
          "AWS::S3::Bucket"
        ]
      },
      "Source": {
        "Owner": "AWS",
        "SourceIdentifier": "S3_BUCKET_LIFECYCLE_POLICY_CHECK"
      },
      "MaximumExecutionFrequency": "TwentyFour_Hours"
    }
  ]
}
